# =====================================================
# TEXPRO RSProyecto — Variables de Entorno
# Copia este archivo como .env y completa los valores
# NUNCA commitear el archivo .env real al repositorio
# =====================================================

# === BASE DE DATOS MYSQL (usuarios, configuración interna) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=texpro_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL
DB_NAME=texpro_db

# === SQL SERVER SOFTLAND (réplica facturación DTE) ===
SOFTLAND_DB_HOST=192.168.1.XX
SOFTLAND_DB_PORT=1433
SOFTLAND_DB_USER=sa
SOFTLAND_DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL
SOFTLAND_DB_NAME=SoftlandDB
SOFTLAND_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Si el certificado del servidor no coincide con el host usado en la conexión, definirlo aquí.
SOFTLAND_DB_HOSTNAME_IN_CERTIFICATE=
# Ruta o nombre del certificado del servidor para validar la conexión cuando aplique.
SOFTLAND_DB_SERVER_CERTIFICATE=

# TLS / Cifrado SQL Server
# SOFTLAND_DB_ENCRYPT: true en producción (Azure/Softland Cloud), false en red local sin TLS
SOFTLAND_DB_ENCRYPT=true

# Tiempo máximo de login en segundos para intentar abrir la conexión a Softland
SOFTLAND_DB_LOGIN_TIMEOUT=5

# SEGURIDAD CRÍTICA: SOFTLAND_DB_TRUST_SERVER_CERT
#   false  → PRODUCCIÓN (obligatorio) — valida certificado del servidor SQL Server
#   true   → solo para desarrollo local con certificado autofirmado
#   Dejar en false previene ataques MITM contra la réplica Softland.
SOFTLAND_DB_TRUST_SERVER_CERT=false

# === AUTENTICACIÓN JWT ===
JWT_SECRET=GENERAR_CLAVE_ALEATORIA_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=8h

# === SERVIDOR ===
PORT=3000
NODE_ENV=development

# FRONTEND_URL: URL del frontend permitida en CORS
# OBLIGATORIO en producción — si no está definida el servidor no arranca.
# En desarrollo se puede dejar como localhost.
FRONTEND_URL=http://localhost:3001

# === BANCO CENTRAL DE CHILE (indicadores económicos: UF y Dólar) ===
# Registro GRATUITO en: https://si3.bcentral.cl/siete/
# Una vez registrado, ingresar aquí el correo y contraseña de la cuenta.
# Si no están configurados, el sistema usa mindicador.cl como respaldo automático.
BCCH_USER=TU_CORREO@ejemplo.com
BCCH_PASS=TU_PASSWORD_BCCH
